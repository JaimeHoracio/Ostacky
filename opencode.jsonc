{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      ".secret/**": "deny"
    },
    "write": {
      "*.env": "deny",
      ".secret/**": "deny"
    },
    "external_directory": {
      "~/.config/superpowers/worktrees/**": "ask"
    }
  },
  "skills": {
    "paths": [
      "assets/skills/using-git-worktrees"
    ]
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "ask-user-server": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/ask-user-server/index.js"
      ],
      "cwd": ".",
      "timeout": 10000,
      "enabled": true
    },
    "ostacky-controller": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/ostacky-controller/index.js"
      ],
      "cwd": ".",
      "timeout": 10000,
      "enabled": true
    }
  }
}
