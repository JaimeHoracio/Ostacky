{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      ".secret/**": "deny"
    },
    "write": {
      "*.env": "deny",
      ".secret/**": "deny"
    },
    "external_directory": {
      "~/.config/superpowers/worktrees/**": "ask"
    }
  },
  "skills": {
    "paths": [
      "assets/skills/using-git-worktrees"
    ]
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        ".opencode/tools/codegraph/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "ostacky-controller": {
      "type": "local",
      "command": [
        "node",
        ".opencode/mcp/ostacky-controller/index.js"
      ],
      "enabled": true
    },
    "engram": {
      "type": "local",
      "command": [
        ".opencode/tools/engram/bin/engram",
        "mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
