{
    "name": "ostacky",
    "version": "0.9.7",
    "description": "Instalador interactivo de agentes y comandos para OpenCode",
    "type": "module",
    "bin": {
        "ostacky": "./dist/cli.js"
    },
    "scripts": {
        "prebuild": "bun run scripts/sync-version.ts && bun run scripts/sync-controller-core.ts",
        "dev": "bun run src/cli.ts",
        "build": "bun build src/cli.ts --target=node --format=esm --outfile dist/cli.js && bun scripts/add-shebang.ts",
        "start": "node dist/cli.js",
        "test": "bun test --isolate",
        "test:safe": "bun run scripts/run-tests-isolated.ts",
        "check:skills": "bun run scripts/check-skill-sync.ts",
        "hash:check": "bun run scripts/update-manifest-hashes.ts --check",
        "hash:update": "bun run scripts/update-manifest-hashes.ts",
        "prepublishOnly": "bun run build",
        "update": "bun run scripts/check-skill-sync.ts && bun run scripts/sync-controller-core.ts && bun run scripts/update-manifest-hashes.ts"
    },
    "files": [
        "dist/",
        "assets/",
        "manifest.json",
        "LICENSE"
    ],
    "keywords": [
        "opencode",
        "installer",
        "cli",
        "agent"
    ],
    "license": "MIT",
    "dependencies": {
        "@clack/prompts": "^0.9.1"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
