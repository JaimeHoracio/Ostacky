{
    "name": "ostacky",
    "version": "0.5.3",
    "description": "Instalador interactivo de agentes y comandos para OpenCode",
    "type": "module",
    "bin": {
        "ostacky": "./dist/cli.js"
    },
    "scripts": {
        "dev": "bun run src/cli.ts",
        "build": "bun build src/cli.ts --target=node --format=esm --outfile dist/cli.js && bun scripts/add-shebang.ts",
        "start": "node dist/cli.js",
        "test": "bun test",
        "prepublishOnly": "bun run build"
    },
    "files": [
        "dist/",
        "assets/",
        "manifest.json",
        "LICENSE"
    ],
    "keywords": [
        "opencode",
        "installer",
        "cli",
        "agent"
    ],
    "license": "MIT",
    "dependencies": {
        "@clack/prompts": "^0.9.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
